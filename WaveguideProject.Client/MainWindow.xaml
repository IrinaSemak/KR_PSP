<Window x:Class="WaveguideProject.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Расчет волноводов (Монте-Карло)" Height="450" Width="400">
    <StackPanel Margin="20">
        <TextBlock Text="Параметры волновода:" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Text="Ширина (a):"/>
        <TextBox x:Name="txtWidth" Text="10.0" Margin="0,0,0,5"/>

        <TextBlock Text="Высота (b):"/>
        <TextBox x:Name="txtHeight" Text="5.0" Margin="0,0,0,5"/>

        <TextBlock Text="Разрешение сетки (nx):"/>
        <TextBox x:Name="txtGrid" Text="20" Margin="0,0,0,5"/>

        <TextBlock Text="Блужданий на узел (точность):"/>
        <TextBox x:Name="txtWalkers" Text="500" Margin="0,0,0,15"/>

        <Button x:Name="BtnCalculate" Content="Рассчитать конфигурацию" Click="BtnCalculate_Click" Padding="10"/>

        <TextBlock Text="Результат вычислений:" FontWeight="Bold" Margin="0,15,0,5"/>
        <TextBox x:Name="txtResult" Height="120" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
    </StackPanel>
</Window>